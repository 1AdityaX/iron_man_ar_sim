{
  "name": "iron-man-ar-sim",
  "private": true,
  "version": "1.0.0",
  "description": "Holo Workshop: Iron Man style workshop holograms you control with your bare hands through a webcam.",
  "type": "module",
  "scripts": {
    "setup-assets": "node scripts/setup-assets.mjs",
    "predev": "npm run setup-assets",
    "dev": "vite",
    "prebuild": "npm run setup-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
